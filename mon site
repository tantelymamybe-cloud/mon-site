<script>
function sendContact(){
  var name=document.getElementById('c-name').value.trim();
  var email=document.getElementById('c-email').value.trim();
  var msg=document.getElementById('c-msg').value.trim();
  if(!msg){alert('Merci d\'écrire un message.');return;}
  var subject=encodeURIComponent('Message de '+(name||'un visiteur')+' — mesoutils.com');
  var body=encodeURIComponent(msg+'\n\n— '+name+' ('+email+')');
  window.location.href='mailto:contact@mesoutils.com?subject='+subject+'&body='+body;
}
</script>

