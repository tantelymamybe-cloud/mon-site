<script>
/* ---------- Navigation ---------- */
function showHome(){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('home').style.display='block';
  window.scrollTo({top:0,behavior:'smooth'});
}
function openTool(id){
  document.getElementById('home').style.display='none';
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-'+id).classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

/* ---------- 1. PDF (images -> PDF) ---------- */
let pdfFiles=[];
const pdfDrop=document.getElementById('pdf-drop');
const pdfInput=document.getElementById('pdf-input');
pdfDrop.onclick=()=>pdfInput.click();
pdfInput.onchange=e=>addPdfFiles(e.target.files);
['dragover','dragleave','drop'].forEach(ev=>pdfDrop.addEventListener(ev,e=>{
  e.preventDefault();pdfDrop.classList.toggle('over',ev==='dragover');
  if(ev==='drop')addPdfFiles(e.dataTransfer.files);
}));
function addPdfFiles(files){
  for(const f of files){if(f.type.startsWith('image/'))pdfFiles.push(f);}
  renderPdfPreview();
}
function renderPdfPreview(){
  const box=document.getElementById('pdf-preview');box.innerHTML='';
  pdfFiles.forEach(f=>{const img=document.createElement('img');img.src=URL.createObjectURL(f);box.appendChild(img);});
}
function clearPdf(){pdfFiles=[];renderPdfPreview();}
function makePdf(){
  if(!pdfFiles.length){alert('Ajoutez au moins une image.');return;}
  const {jsPDF}=window.jspdf;const doc=new jsPDF();let i=0;
  const next=()=>{
    if(i>=pdfFiles.length){doc.save('mesoutils.pdf');return;}
    const reader=new FileReader();
    reader.onload=e=>{
      const img=new Image();
      img.onload=()=>{
        const pw=doc.internal.pageSize.getWidth(),ph=doc.internal.pageSize.getHeight();
        const r=Math.min(pw/img.width,ph/img.height);
        const w=img.width*r,h=img.height*r;
        if(i>0)doc.addPage();
        doc.addImage(e.target.result,'JPEG',(pw-w)/2,(ph-h)/2,w,h);
        i++;next();
      };
      img.src=e.target.result;
    };
    reader.readAsDataURL(pdfFiles[i]);
  };
  next();
}

/* ---------- 2. Image compressor ---------- */
let imgBlob=null,imgName='image';
const imgDrop=document.getElementById('img-drop'),imgInput=document.getElementById('img-input');
const imgQ=document.getElementById('img-quality');
imgDrop.onclick=()=>imgInput.click();
imgInput.onchange=e=>loadImg(e.target.files[0]);
imgQ.oninput=()=>{document.getElementById('img-qval').textContent=imgQ.value;if(window._imgSource)compressImg();};
['dragover','dragleave','drop'].forEach(ev=>imgDrop.addEventListener(ev,e=>{
  e.preventDefault();imgDrop.classList.toggle('over',ev==='dragover');
  if(ev==='drop')loadImg(e.dataTransfer.files[0]);
}));
function loadImg(file){
  if(!file||!file.type.startsWith('image/'))return;
  imgName=file.name.replace(/\.[^.]+$/,'');
  window._origSize=file.size;
  const r=new FileReader();
  r.onload=e=>{const im=new Image();im.onload=()=>{window._imgSource=im;compressImg();};im.src=e.target.result;};
  r.readAsDataURL(file);
}
function compressImg(){
  const im=window._imgSource;const c=document.createElement('canvas');
  c.width=im.width;c.height=im.height;c.getContext('2d').drawImage(im,0,0);
  c.toBlob(b=>{
    imgBlob=b;
    document.getElementById('img-preview').innerHTML='<img src="'+URL.createObjectURL(b)+'">';
    const stats=document.getElementById('img-stats');
    const gain=Math.max(0,Math.round((1-b.size/window._origSize)*100));
    stats.innerHTML='Original : <b>'+fmtSize(window._origSize)+'</b> → Compressé : <b>'+fmtSize(b.size)+'</b> &nbsp; (-'+gain+'%)';
    stats.classList.add('show');
    document.getElementById('img-dl').disabled=false;
  },'image/jpeg',imgQ.value/100);
}
function downloadImg(){if(!imgBlob)return;const a=document.createElement('a');a.href=URL.createObjectURL(imgBlob);a.download=imgName+'-compresse.jpg';a.click();}
function fmtSize(b){return b<1024?b+' o':b<1048576?(b/1024).toFixed(1)+' Ko':(b/1048576).toFixed(2)+' Mo';}

/* ---------- 3. QR code ---------- */
let qrObj=null;
function makeQr(){
  const text=document.getElementById('qr-text').value.trim();
  if(!text){alert('Entrez un texte ou un lien.');return;}
  const size=+document.getElementById('qr-size').value;
  const color=document.getElementById('qr-color').value;
  document.getElementById('qrcode').innerHTML='';
  qrObj=new QRCode(document.getElementById('qrcode'),{text,width:size,height:size,colorDark:color,colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.H});
  setTimeout(()=>document.getElementById('qr-dl').disabled=false,150);
}
function downloadQr(){
  const cv=document.querySelector('#qrcode canvas');if(!cv)return;
  const a=document.createElement('a');a.href=cv.toDataURL('image/png');a.download='qrcode-mesoutils.png';a.click();
}

/* ---------- 4. Percentage ---------- */
function pctLabels(){
  const m=document.getElementById('pct-mode').value;
  const l1=document.getElementById('pct-l1'),l2=document.getElementById('pct-l2');
  if(m==='of'){l1.textContent='Pourcentage (%)';l2.textContent='Valeur';}
  if(m==='is'){l1.textContent='Valeur';l2.textContent='Total';}
  if(m==='change'){l1.textContent='Valeur de départ';l2.textContent='Valeur d\'arrivée';}
}
function calcPct(){
  const a=parseFloat(document.getElementById('pct-a').value);
  const b=parseFloat(document.getElementById('pct-b').value);
  const m=document.getElementById('pct-mode').value;
  const res=document.getElementById('pct-res');
  if(isNaN(a)||isNaN(b)){alert('Entrez deux valeurs.');return;}
  let out='';
  if(m==='of')out=a+' % de '+b+' = <b>'+round(a*b/100)+'</b>';
  if(m==='is')out=a+' représente <b>'+round(a/b*100)+' %</b> de '+b;
  if(m==='change'){const d=round((b-a)/Math.abs(a)*100);out='Variation : <b>'+(d>=0?'+':'')+d+' %</b>';}
  res.innerHTML=out;res.classList.add('show');
}
function round(n){return Math.round(n*100)/100;}

/* ---------- 5. Currency ---------- */
const CURRENCIES=['EUR','USD','GBP','CHF','CAD','AUD','JPY','CNY','INR','BRL','ZAR','MXN','SGD','HKD','SEK','NOK','DKK','PLN','TRY','NZD','KRW','THB','MYR','IDR','PHP','CZK','HUF','RON','ILS','BGN','ISK'];
function fillCur(){
  const from=document.getElementById('cur-from'),to=document.getElementById('cur-to');
  CURRENCIES.forEach(c=>{from.add(new Option(c,c));to.add(new Option(c,c));});
  from.value='EUR';to.value='USD';
}
function swapCur(){
  const f=document.getElementById('cur-from'),t=document.getElementById('cur-to');
  [f.value,t.value]=[t.value,f.value];convertCur();
}
async function convertCur(){
  const amount=parseFloat(document.getElementById('cur-amount').value);
  const from=document.getElementById('cur-from').value,to=document.getElementById('cur-to').value;
  const res=document.getElementById('cur-res');
  if(isNaN(amount)){alert('Entrez un montant.');return;}
  res.classList.add('show');res.innerHTML='Conversion en cours…';
  if(from===to){res.innerHTML=amount+' '+from+' = <b>'+amount+' '+to+'</b>';return;}
  try{
    const r=await fetch('https://api.frankfurter.app/latest?amount='+amount+'&from='+from+'&to='+to);
    const d=await r.json();
    const val=d.rates[to];
    res.innerHTML=amount+' '+from+' = <b>'+val.toLocaleString('fr-FR',{maximumFractionDigits:2})+' '+to+'</b><br><span class="hint">Taux du '+d.date+'</span>';
  }catch(e){
    res.innerHTML='Impossible de récupérer le taux. Vérifiez votre connexion internet.';
  }
}

/* ---------- 6. Password ---------- */
function makePwd(){
  const len=+document.getElementById('pwd-length').value;
  let set='';
  if(document.getElementById('pwd-upper').checked)set+='ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  if(document.getElementById('pwd-lower').checked)set+='abcdefghijklmnopqrstuvwxyz';
  if(document.getElementById('pwd-num').checked)set+='0123456789';
  if(document.getElementById('pwd-sym').checked)set+='!@#$%^&*()-_=+[]{}?';
  if(!set){alert('Cochez au moins une option.');return;}
  let pwd='';const arr=new Uint32Array(len);crypto.getRandomValues(arr);
  for(let i=0;i<len;i++)pwd+=set[arr[i]%set.length];
  document.getElementById('pwd-val').textContent=pwd;
  scorePwd(pwd,set.length);
}
function scorePwd(pwd,poolSize){
  const entropy=pwd.length*Math.log2(poolSize);
  const m=document.getElementById('pwd-meter'),t=document.getElementById('pwd-strength');
  let pct,color,label;
  if(entropy<40){pct=33;color='#E5484D';label='Faible';}
  else if(entropy<70){pct=66;color='#F59E0B';label='Moyen';}
  else{pct=100;color='#10B981';label='Très fort';}
  m.style.width=pct+'%';m.style.background=color;
  t.textContent='Sécurité : '+label+' (~'+Math.round(entropy)+' bits)';
}
function copyPwd(){
  const v=document.getElementById('pwd-val').textContent;
  if(v.startsWith('cliquez'))return;
  navigator.clipboard.writeText(v).then(()=>{
    const b=event.target;const o=b.textContent;b.textContent='Copié ✓';setTimeout(()=>b.textContent=o,1200);
  });
}

/* ---------- 7. Translator ---------- */
function trnCheck(){
  const f=document.getElementById('trn-from'),t=document.getElementById('trn-to');
  if(f.value===t.value){
    // si identiques, on bascule la cible vers une autre langue
    const others=['fr','en','de'].filter(l=>l!==f.value);
    t.value=others[0];
  }
}
function swapTrn(){
  const f=document.getElementById('trn-from'),t=document.getElementById('trn-to');
  [f.value,t.value]=[t.value,f.value];
  const src=document.getElementById('trn-src'),out=document.getElementById('trn-out');
  src.value=out.value;out.value='';
}
async function translateText(){
  const text=document.getElementById('trn-src').value.trim();
  const from=document.getElementById('trn-from').value;
  const to=document.getElementById('trn-to').value;
  const out=document.getElementById('trn-out');
  if(!text){alert('Entrez un texte à traduire.');return;}
  if(from===to){out.value=text;return;}
  out.value='Traduction en cours…';
  try{
    const url='https://api.mymemory.translated.net/get?q='+encodeURIComponent(text)+'&langpair='+from+'|'+to;
    const r=await fetch(url);
    const d=await r.json();
    if(d.responseData&&d.responseData.translatedText){
      out.value=d.responseData.translatedText;
    }else{
      out.value='Désolé, la traduction a échoué. Réessayez.';
    }
  }catch(e){
    out.value='Impossible de traduire. Vérifiez votre connexion internet.';
  }
}
function copyTrn(){
  const v=document.getElementById('trn-out').value;
  if(!v)return;
  navigator.clipboard.writeText(v).then(()=>{
    const b=event.target;const o=b.textContent;b.textContent='Copié ✓';setTimeout(()=>b.textContent=o,1200);
  });
}

/* init */
fillCur();pctLabels();
</script>
